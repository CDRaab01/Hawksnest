<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Hawksnest</string>

    <!-- Home-screen widgets. These labels and descriptions are what the launcher's widget
         picker shows, so each one says what the widget does, not what it is. -->
    <string name="widget_light_label">Hawksnest Light</string>
    <string name="widget_light_description">Toggle and dim one light.</string>
    <string name="widget_lock_label">Hawksnest Lock</string>
    <string name="widget_lock_description">Lock a door, or unlock it with a confirming second tap.</string>
    <string name="widget_alarm_label">Hawksnest Alarm</string>
    <string name="widget_alarm_description">Arm home, arm away, or disarm the alarm panel.</string>
    <string name="widget_temperature_label">Hawksnest Temperature</string>
    <string name="widget_temperature_description">A room\'s temperature, coloured by whether it\'s comfortable.</string>
    <string name="widget_switch_label">Hawksnest Switch</string>
    <string name="widget_switch_description">A paddle for one on/off switch — on top, off below.</string>
    <string name="widget_scene_pad_label">Hawksnest Scene Pad</string>
    <string name="widget_scene_pad_description">A copy of the wall scene controller: relay on top, four scene keys below.</string>
    <string name="widget_garage_label">Hawksnest Garage</string>
    <string name="widget_garage_description">Whether a garage door is open or closed. Adds a button only if the door has an opener.</string>
</resources>
