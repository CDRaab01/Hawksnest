<!--
  Widget-picker preview glyph: a paddle switch seen face-on, its top half lit. Tinted PulseOrange
  (the streak channel the switch widget wears, same as the light).

  Drawn as the widget draws itself — one plate split into two halves — so the picker entry is
  recognisably this widget and not the light one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFF8A5C">
    <!-- The plate. -->
    <path
        android:fillColor="@android:color/white"
        android:fillAlpha="0.30"
        android:pathData="M7,2h10c1.1,0 2,0.9 2,2v16c0,1.1 -0.9,2 -2,2H7c-1.1,0 -2,-0.9 -2,-2V4c0,-1.1 0.9,-2 2,-2z" />
    <!-- The lit upper half — this is the "on" the preview is showing. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8,4h8c0.55,0 1,0.45 1,1v6c0,0.55 -0.45,1 -1,1H8c-0.55,0 -1,-0.45 -1,-1V5c0,-0.55 0.45,-1 1,-1z" />
    <!-- The resting lower half, held by its outline only. -->
    <path
        android:fillColor="@android:color/white"
        android:fillAlpha="0.45"
        android:pathData="M8,13h8c0.55,0 1,0.45 1,1v5c0,0.55 -0.45,1 -1,1H8c-0.55,0 -1,-0.45 -1,-1v-5c0,-0.55 0.45,-1 1,-1zM8,14v5h8v-5z" />
</vector>
