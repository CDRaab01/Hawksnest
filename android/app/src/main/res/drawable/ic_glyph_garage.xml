<?xml version="1.0" encoding="utf-8"?>
<!--
  In-widget glyph: a garage with its door DOWN — the garage widget's mark when the door is shut.
  Tinted at draw time.

  Drawn as a roof chevron, two posts and three slats rather than borrowed from Material's `garage`
  icon, which puts a car in the opening. A car is a different fact from a door's position, and at
  20dp on a home screen the two shapes have to differ in silhouette alone — see the open twin,
  which keeps the roof and posts identical so only the slats change.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Roof -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,2.5L1.5,8v2.2L12,4.7l10.5,5.5V8z" />
    <!-- Posts -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.5,10.5h2.2V21H2.5z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19.3,10.5h2.2V21h-2.2z" />
    <!-- Door: three slats filling the opening -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.7,11h14.6v2H4.7z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.7,14.3h14.6v2H4.7z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4.7,17.6h14.6v2H4.7z" />
</vector>
