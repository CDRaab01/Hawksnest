<?xml version="1.0" encoding="utf-8"?>
<!--
  See light_widget_info.xml for the sizing and refresh reasoning; this widget takes the lock's
  numbers verbatim because it has the same two shapes — a header alone when the door is only
  watched, a header over one full-width button when it can actually be driven.

  updatePeriodMillis is 0 ON PURPOSE — see light_widget_info.xml. It used to be left declared
  because a widget with no periodic update at all never recovers if render-time reads and the
  live bridge are both dead; that safety net is now the single WorkManager job in
  widget/WidgetRefreshScheduler, which covers every widget in one wake.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="400dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@drawable/ic_widget_garage"
    android:description="@string/widget_garage_description"
    android:configure="com.hawksnest.widget.WidgetConfigActivity"
    android:widgetCategory="home_screen" />
