<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY (merged over src/main for debug builds; never in a release APK). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Posts a made-up alert through the real PushNotifier, so notification taps and buttons
             can be tested on an emulator without sending anything to the household's ntfy topic
             (which every phone in the house listens to). Guarded by DUMP, a permission only the
             shell holds: `adb shell am broadcast` can reach it, other apps cannot. -->
        <receiver
            android:name=".push.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.hawksnest.debug.PUSH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
